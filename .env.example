# 현재 사용하는 제공 AI API
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# 이전 Bedrock 직접 연결 전용: 현재 게이트웨이에서는 사용하지 않음
AWS_REGION=
AWS_PROFILE=
BEDROCK_MODEL_ID=

# 웹 앱 로컬 실행 (npm start)
PORT=3001
APP_ORIGIN=http://localhost:3001
DATABASE_PATH=.data/parts.sqlite
# 요청당 최대 2회 호출. 100 요청이면 최대 200회 공급자 호출
AI_DAILY_REQUEST_LIMIT=100
# 실제 배포에서는 NODE_ENV=production, APP_ORIGIN=https://실제도메인
